# Environnement des tests automatisés (FIUCC-79) — jamais la base de
# développement, a fortiori jamais la production. tests/bootstrap.php refuse
# de démarrer si APP_ENV n'est pas exactement "testing" ou si DB_DATABASE ne
# se termine pas par "_test" (voir docs/SECURITE_ELECTIONS.md pour le
# raisonnement, et tests/Bootstrap/DatabaseIsolationGuardTest.php pour la
# preuve que ce refus fonctionne réellement).
#
# Copier en .env.testing, créer la base indiquée (vide), puis :
#   php database/migrate.php --env=testing
#   composer test

APP_NAME="FIUCC Portal (tests)"
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fr
APP_KEY=

# --- Base de données (MySQL) — DB_DATABASE DOIT se terminer par "_test" ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=congolese_community_test
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Email : toujours "log" en test, jamais d'envoi réel ---
MAIL_DRIVER=log
MAIL_REVEAL_SECRETS=false
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="FIUCC Portal (tests)"

# --- Sécurité (valeurs par défaut de config/security.php, listées pour être explicites) ---
SESSION_LIFETIME=120
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_HOUR=5
VOTE_TOKEN_TTL_HOURS=72
VOTE_TOKEN_MAX_ATTEMPTS=5
UPLOAD_MAX_SIZE_MB=15
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MEMBER_LOGIN_THROTTLE_STEP_SECONDS=5
MEMBER_LOGIN_THROTTLE_MAX_SECONDS=30
PASSWORD_MIN_LENGTH=6

ALLOWED_EMAIL_DOMAINS=final.edu.tr,std.final.edu.tr
