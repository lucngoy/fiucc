APP_NAME="Congolese Community of Final"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_KEY=

# --- Base de données (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=congolese_community
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Email (PHPMailer / SMTP) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Congolese Community of Final"

# --- Sécurité ---
SESSION_LIFETIME=120
OTP_TTL_MINUTES=15
VOTE_TOKEN_TTL_HOURS=72
UPLOAD_MAX_SIZE_MB=5
