APP_NAME="Congolese Community of Final"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fr
APP_KEY=

# --- Base de données (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=congolese_community
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Email (PHPMailer / SMTP) ---
# log : aucun email réel, écrit dans storage/logs/mail.log (défaut, sûr en local)
# smtp : envoi réel — à positionner explicitement en prod
MAIL_DRIVER=log
# true : ne masque pas les secrets (OTP...) dans mail.log — UNIQUEMENT si
# APP_ENV=local aussi, pour tester un parcours OTP en local. Toute autre
# combinaison masque quand même ; si true hors local, un avertissement est
# journalisé à chaque requête (le flag est ignoré, pas juste toléré).
MAIL_REVEAL_SECRETS=false
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Congolese Community of Final"

# --- Sécurité ---
SESSION_LIFETIME=120
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_HOUR=5
VOTE_TOKEN_TTL_HOURS=72
UPLOAD_MAX_SIZE_MB=15
UPLOAD_PHOTO_MAX_DIMENSION=800
UPLOAD_EVENT_COVER_MAX_DIMENSION=1600
UPLOAD_GALLERY_PHOTO_MAX_DIMENSION=1600
UPLOAD_GALLERY_THUMBNAIL_DIMENSION=400
UPLOAD_NEWS_COVER_MAX_DIMENSION=1600
UPLOAD_DOCUMENT_MAX_SIZE_MB=15
UPLOAD_MAX_INPUT_DIMENSION=5000
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MEMBER_LOGIN_THROTTLE_STEP_SECONDS=5
MEMBER_LOGIN_THROTTLE_MAX_SECONDS=30
PASSWORD_MIN_LENGTH=6

# --- Recensement (FIUCC-31/32) ---
# Domaine étudiant réel à confirmer — une erreur ici bloquerait toutes les inscriptions.
ALLOWED_EMAIL_DOMAINS=final.edu.tr,std.final.edu.tr
