# Environnement
.env
.env.*
!.env.example
!.env.testing.example

# Dépendances
/vendor/
/node_modules/

# PHPUnit
/.phpunit.cache/
/.phpunit.result.cache

# Uploads : le contenu ne va JAMAIS dans git (photos de membres, données perso).
# /public/uploads/* ignorerait aussi les sous-dossiers eux-mêmes (git ne
# descend pas dans un dossier ignoré pour appliquer une négation plus bas) —
# chaque sous-dossier d'upload est donc listé explicitement, comme pour
# storage/ ci-dessous. Une nouvelle catégorie d'upload doit ajouter sa
# propre ligne ici (FIUCC-81, découvert en préparant le handoff : sans ça,
# public/uploads/.htaccess — qui bloque toute exécution PHP dans ce dossier,
# règle de sécurité non négociable — n'était pas versionné, ni les dossiers
# eux-mêmes : un clone frais n'avait aucun de ces dossiers).
/public/uploads/candidates/*
/public/uploads/documents/*
/public/uploads/events/*
/public/uploads/gallery/*
/public/uploads/members/*
/public/uploads/news/*
/public/uploads/partners/*
!/public/uploads/**/.gitkeep

# Stockage runtime
/storage/logs/*
/storage/cache/*
/storage/backups/*
# storage/documents (FIUCC-57/58) : fichiers hors public/, jamais servis
# directement par Apache — un document en visibilité members/admin ne doit
# jamais être un fichier statique atteignable, seulement streamé par
# DocumentController::download() après vérification des droits.
/storage/documents/*
# storage/passports (migration 018) : scans de passeport du recensement,
# même principe que storage/documents — streamés uniquement par
# Admin\MemberController::passportScan(), jamais une URL statique.
/storage/passports/*
# Scratch d'upload et de logs des tests (FIUCC-79) — jamais public/uploads/,
# storage/documents ou storage/logs réels, voir .env.testing.example.
/storage/testing_uploads/*
/storage/testing_logs/*
# Scratch de sauvegardes des tests (FIUCC-80) — jamais storage/backups réel.
/storage/testing_backups/*
!/storage/**/.gitkeep

# Build
# app.css est généré par `npm run build:css` mais commité : la prod n'a pas
# Node.js et ne doit lancer aucune étape de build (voir CLAUDE.md).
/public/assets/css/*.map

# Système
.DS_Store
Thumbs.db
*.log
*.sql.gz

# Éditeurs
.idea/
.vscode/
*.swp
