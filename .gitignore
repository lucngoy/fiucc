# Environnement
.env
.env.*
!.env.example

# Dépendances
/vendor/
/node_modules/

# Uploads : le contenu ne va JAMAIS dans git (photos de membres, données perso)
/public/uploads/*
!/public/uploads/**/.gitkeep

# Stockage runtime
/storage/logs/*
/storage/cache/*
/storage/backups/*
!/storage/**/.gitkeep

# Build
# app.css est généré par `npm run build:css` mais commité : la prod n'a pas
# Node.js et ne doit lancer aucune étape de build (voir CLAUDE.md).
/public/assets/css/*.map

# Système
.DS_Store
Thumbs.db
*.log
*.sql.gz

# Éditeurs
.idea/
.vscode/
*.swp
