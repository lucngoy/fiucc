# Environnement
.env
.env.*
!.env.example
!.env.testing.example

# Dépendances
/vendor/
/node_modules/

# PHPUnit
/.phpunit.cache/
/.phpunit.result.cache

# Uploads : le contenu ne va JAMAIS dans git (photos de membres, données perso)
/public/uploads/*
!/public/uploads/**/.gitkeep

# Stockage runtime
/storage/logs/*
/storage/cache/*
/storage/backups/*
# storage/documents (FIUCC-57/58) : fichiers hors public/, jamais servis
# directement par Apache — un document en visibilité members/admin ne doit
# jamais être un fichier statique atteignable, seulement streamé par
# DocumentController::download() après vérification des droits.
/storage/documents/*
# Scratch d'upload et de logs des tests (FIUCC-79) — jamais public/uploads/,
# storage/documents ou storage/logs réels, voir .env.testing.example.
/storage/testing_uploads/*
/storage/testing_logs/*
# Scratch de sauvegardes des tests (FIUCC-80) — jamais storage/backups réel.
/storage/testing_backups/*
!/storage/**/.gitkeep

# Build
# app.css est généré par `npm run build:css` mais commité : la prod n'a pas
# Node.js et ne doit lancer aucune étape de build (voir CLAUDE.md).
/public/assets/css/*.map

# Système
.DS_Store
Thumbs.db
*.log
*.sql.gz

# Éditeurs
.idea/
.vscode/
*.swp
