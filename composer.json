{
  "name": "fiucc/portal",
  "description": "Official digital portal of the Congolese Community of Final International University",
  "type": "project",
  "license": "proprietary",
  "authors": [
    {
      "name": "Congolese Community of Final",
      "homepage": "https://github.com/lucngoy/fiucc"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-zip": "*",
    "phpmailer/phpmailer": "^6.9"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Helpers/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "scripts": {
    "test": [
      "php database/migrate.php --env=testing",
      "phpunit"
    ]
  }
}
